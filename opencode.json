{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "alejandra": {
      "command": [
        "alejandra",
        "$FILE"
      ],
      "extensions": [
        ".nix"
      ]
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "bootdev submit *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow"
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow"
    }
  ]
}
